{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "ignore": [
    "**/*.d.ts",
    "**/*.gen.ts",
    "**/*.config.{ts,cjs,mjs,js}",
    ".agents/**",
    ".claude/**",
    ".dependency-cruiser.cjs",
    ".goose/**",
    ".ncurc.cjs",
    ".vite-hooks/**",
    "apps/web/content-collections.ts"
  ],
  "ignoreBinaries": ["createdb", "wait"],
  "ignoreDependencies": ["dotenv", "babel-plugin-react-compiler"],
  "workspaces": {
    ".": {
      "entry": ["vite.config.ts", "scripts/*.mjs"]
    },
    "apps/web": {
      "entry": ["src/routes/**/*.tsx", "src/router.tsx"],
      "ignoreDependencies": ["@ultimate-ts-starter/*"]
    },
    "apps/server": {
      "entry": ["src/index.ts"],
      "ignoreDependencies": ["@ultimate-ts-starter/*"]
    },
    "apps/native": {
      "entry": ["app/**/*.tsx"],
      "ignoreDependencies": ["@ultimate-ts-starter/*"]
    },
    "apps/tui": {
      "entry": ["src/index.tsx"],
      "ignoreDependencies": ["@ultimate-ts-starter/*"]
    },
    "apps/extension": {
      "entry": ["entrypoints/**/*.{ts,tsx}"],
      "ignoreDependencies": ["@ultimate-ts-starter/*"]
    },
    "packages/auth": {
      "entry": ["auth.ts", "src/**/*.ts"],
      "ignoreDependencies": ["@ultimate-ts-starter/*"]
    },
    "packages/*": {
      "entry": ["src/**/*.ts"],
      "ignoreDependencies": ["@ultimate-ts-starter/*"]
    }
  }
}
