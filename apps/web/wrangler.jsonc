{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "web",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  // Workers Observability — logs + traces in the Cloudflare dashboard.
  // Traces need their own opt-in (`enabled: true` alone is logs-only).
  // Lower `head_sampling_rate` on high-traffic Workers to manage volume:
  // https://developers.cloudflare.com/workers/observability/logs/workers-logs/#head-based-sampling
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "invocation_logs": true },
    "traces": { "enabled": true, "head_sampling_rate": 0.05 },
  },
  // Set build-time vars in the CI `Deploy web` step; runtime vars here.
  // "vars": {},
  // Routes / custom domains — configure in the Cloudflare dashboard or add here later.
  // "routes": [{ "pattern": "example.com", "custom_domain": true }],
}
