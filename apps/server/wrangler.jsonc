{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "server",
  "main": "src/index.ts",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "dev": {
    "port": 3000,
  },
  // Workers Observability — logs + traces in the Cloudflare dashboard.
  // `enabled: true` is the default for new Workers but kept explicit so
  // every fork sees it. Traces need their own opt-in (logs-only otherwise).
  // Lower `head_sampling_rate` on high-traffic Workers to manage volume:
  // https://developers.cloudflare.com/workers/observability/logs/workers-logs/#head-based-sampling
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "invocation_logs": true },
    "traces": { "enabled": true, "head_sampling_rate": 0.05 },
  },
  // Non-secret vars — set values in .dev.vars for local dev
  "vars": {
    "NODE_ENV": "production",
    "CORS_ORIGIN": "",
    "POLAR_SUCCESS_URL": "",
    "EMAIL_FROM": "",
  },
  // Secrets (DATABASE_URL, BETTER_AUTH_SECRET, POLAR_ACCESS_TOKEN)
  // are set via `wrangler secret put <NAME>`

  // Cloudflare Email Service — onboard your domain at dash.cloudflare.com →
  // Compute & AI → Email Service, then add SPF + DKIM DNS records.
  // `remote: true` lets `wrangler dev` send via the real Email Service API.
  "send_email": [{ "name": "EMAIL", "remote": true }],

  // Durable Objects — real-time WebSocket events per user
  "durable_objects": {
    "bindings": [{ "name": "USER_EVENTS", "class_name": "UserEvents" }],
  },
  "migrations": [{ "tag": "v1", "new_classes": ["UserEvents"] }],

  // Hyperdrive — connection pooling for PostgreSQL in production
  // Create with: wrangler hyperdrive create <NAME> --connection-string="postgres://..."
  // Set CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=<your DATABASE_URL> in .dev.vars for local dev
  // "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "your-hyperdrive-id" }],

  // Uncomment to enable cron triggers:
  // "triggers": { "crons": ["0 * * * *"] },

  // Uncomment to enable R2 file uploads:
  // "r2_buckets": [{ "binding": "R2_BUCKET", "bucket_name": "uploads" }],

  // Uncomment to enable KV caching:
  // "kv_namespaces": [{ "binding": "KV_CACHE", "id": "your-kv-namespace-id" }]
}
